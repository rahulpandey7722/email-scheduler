NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP Configuration (Ethereal Mail for testing)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_username
SMTP_PASS=your_ethereal_password

# Authentication & Security
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
JWT_SECRET=super_secret_jwt_encryption_key_change_me_in_prod_12345

# Delivery Pacing & System Limits
MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200
WORKER_CONCURRENCY=10
